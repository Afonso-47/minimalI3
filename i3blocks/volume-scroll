#!/bin/bash

# Debug logging (remove after testing)
# echo "$(date): Button $BLOCK_BUTTON" >> /tmp/volume-debug.log

# Ensure we have a valid default sink
DEFAULT_SINK="@DEFAULT_AUDIO_SINK@"

case $BLOCK_BUTTON in
    4) wpctl set-volume "$DEFAULT_SINK" 1%+ ;;
    5) wpctl set-volume "$DEFAULT_SINK" 1%- ;;
    1) wpctl set-mute "$DEFAULT_SINK" toggle ;;
esac

# Get volume with proper error handling
VOLUME_INFO=$(wpctl get-volume "$DEFAULT_SINK" 2>/dev/null)
if [ $? -ne 0 ] || [ -z "$VOLUME_INFO" ]; then
    echo "♪ ?%"
    exit 1
fi

# Check if muted
if echo "$VOLUME_INFO" | grep -q "MUTED"; then
    echo "🔇 Muted"
else
    VOLUME=$(echo "$VOLUME_INFO" | awk '{printf "%d\n", $2 * 100}')
    # Ensure volume is a valid number between 0-100
    if [[ "$VOLUME" =~ ^[0-9]+$ ]] && [ "$VOLUME" -ge 0 ] && [ "$VOLUME" -le 100 ]; then
        echo "♪ ${VOLUME}%"
    else
        echo "♪ ?%"
    fi
fi

# Signal i3blocks to refresh (don't fail if i3blocks isn't running)
pkill -RTMIN+1 i3blocks 2>/dev/null || true
