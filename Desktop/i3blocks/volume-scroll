#!/bin/bash

# Volume block: scroll to change volume, click to toggle mute
# Adapted from the Desktop config's wpctl version, using pactl instead
# since that's what T480's XF86Audio keybinds already use.

SINK="@DEFAULT_SINK@"

case "$BLOCK_BUTTON" in
    1) pactl set-sink-mute "$SINK" toggle ;;
    4) pactl set-sink-volume "$SINK" +1% ;;
    5) pactl set-sink-volume "$SINK" -1% ;;
esac

MUTED=$(pactl get-sink-mute "$SINK" 2>/dev/null | grep -q "yes" && echo yes)
VOLUME=$(pactl get-sink-volume "$SINK" 2>/dev/null | grep -oP '\d+(?=%)' | head -1)

if [ "$MUTED" = "yes" ]; then
    echo "󰝟 muted"
    echo "󰝟"
    echo "#665c54"
elif [[ "$VOLUME" =~ ^[0-9]+$ ]]; then
    echo "󰕾 ${VOLUME}%"
    echo "󰕾 ${VOLUME}%"
    echo "#ebdbb2"
else
    echo "󰕾 ?%"
    echo "󰕾 ?%"
fi

# Refresh this block immediately after a click/scroll
pkill -RTMIN+1 i3blocks 2>/dev/null || true
