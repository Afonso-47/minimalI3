#!/bin/bash

# Check ~/.config/sxhkdrc
# Check ~/.config/i3/scripts/set-bar-flag.sh

bar_visible=false

is_combo_pressed() {
    [ "$(cat /tmp/bar_combo_flag 2>/dev/null)" = "1" ]
}

while true; do
    if ! pgrep -x i3 > /dev/null; then
        exit 0
    fi

    MOUSE_Y=$(xdotool getmouselocation --shell | grep Y | cut -d'=' -f2)

    if is_combo_pressed || [ "$MOUSE_Y" -le 5 ]; then
        if ! $bar_visible; then
            i3-msg bar mode dock
            bar_visible=true
        fi
    else
        if [ "$MOUSE_Y" -gt 20 ]; then
            if $bar_visible; then
                i3-msg bar mode hide
                bar_visible=false
            fi
        fi
    fi

    sleep 0.1
done
