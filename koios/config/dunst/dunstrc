[global]
    ### Display & Position ###
    # Use the new syntax: (horizontal, vertical) offset
    offset = (10, 10)
    origin = top-center

    ### Geometry ###
    # Use the new height syntax: (min_height, max_height)
    height = (0, 300)
    width = 300

    ### History & Timeouts ###
    history_length = 20
    timeout = 5

    ### Appearance ###
    font = "Iosevka Nerd Font 11"
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#504945"
    urgency = normal

### Urgency-Specific Rules (gruvbox-dark) ###
[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    timeout = 4

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    timeout = 5

[urgency_critical]
    background = "#fb4934"
    foreground = "#282828"
    timeout = 0
